 {
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        },
        "Console": {
            "LogLevel": {
                "Services": "Information",
                "MyWebApi.Controllers": "None",
                "DbRepos": "None"
            }
        },
        "InMemory": {
            "LogLevel": {
                "Services": "Information",
                "MyWebApi.Controllers": "Information",
                "DbRepos": "Information"
            }
        }
    },

    "AllowedHosts": "*",

    "ApplicationSecrets": {
        "SecretStorage": "UserSecrets"
    },

    "DatabaseConnections": {
        "DefaultDataUser": "root",
        "MigrationUser": "root",
        "UseDataSetWithTag": "sql-travelapp.sqlserver.docker"
    },

    "ConnectionSets": {
        "DataSets": [
            {
                "DbTag": "sql-travelapp.sqlserver.docker",
                "DbServer": "SqlServer",
                "DbConnections": [
                    { "DbUserLogin": "root", "DbConnection": "TravelAppDb" }
                ]
            }
        ]
    }
}